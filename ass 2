Function in Python
1. Positive, Negative or Zero

def check_num(n):
    if n > 0:
        print("Positive")
    elif n < 0:
        print("Negative")
    else:
        print("Zero")

check_num(int(input()))

2. Even or Odd
def even_odd(n):
    if n % 2 == 0:
        print("Even")
    else:
        print("Odd")

even_odd(int(input()))

3. Greater of Two Numbers
def greater(a, b):
    return a if a > b else b

print(greater(10, 20))

4. Eligible to Vote

def vote(age):
    if age >= 18:
        print("Eligible")
    else:
        print("Not Eligible")

vote(int(input()))

5. Divisible by 5
