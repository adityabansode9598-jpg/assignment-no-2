d = {"a":1}
d["b"] = 2
print(d)

5. Update Value
d = {"a":1}
d["a"] = 10
print(d)

6. Check Key Exists
d = {"a":1,"b":2}

if "a" in d:
    print("Exists")
else:
    print("Not Exists")

7. Remove Key-Value Pair
d = {"a":1,"b":2}
