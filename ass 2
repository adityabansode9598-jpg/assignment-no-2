for i in nums:
    print(i)

2. Largest element 

nums = [10,20,5,40]
print(max(nums))

3. Smallest Element
nums = [10,20,5,40]
print(min(nums))

4. Sum of List

nums = [1,2,3,4,5]
print(sum(nums))
5. Average of List

nums = [1,2,3,4,5]
print(sum(nums)/len(nums))

6. Count Even Numbers
nums = [1,2,3,4,5,6]
count = 0

for i in nums:
    if i % 2 == 0:
        count += 1

print(count)

7. List of Odd Numbers
nums = [1,2,3,4,5,6]
odd = []

for i in nums:
    if i % 2 != 0:
        odd.append(i)

print(odd)

8. Element Exists in List
