10. Multiplication Table
def table(n):
    for i in range(1, 11):
        print(n * i)

table(5)

11. Square of Number
def square(n):
    return n * n

print(square(5))

12. Factorial
def factorial(n):
    fact = 1
    for i in range(1, n + 1):
        fact *= i
    return fact

print(factorial(5))

13. Prime Number
def prime(n):
    for i in range(2, n):
        if n % i == 0:
            print("Not Prime")
            return
    print("Prime")

prime(7)

14. Sum of Digits
def digit_sum(n):
    s = 0
    while n > 0:
        s += n % 10
        n //= 10
    return s

print(digit_sum(123))

15. Sum from 1 to n
def sum_n(n):
    return sum(range(1, n + 1))

print(sum_n(10))

List in Python

1. Print List Elements
